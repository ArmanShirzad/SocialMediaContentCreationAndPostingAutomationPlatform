<div class="mb-8">
  <h1 class="text-2xl font-bold tracking-tight mb-1">뉴스 검색</h1>
  <p class="text-sm text-text-muted">키워드로 뉴스를 검색하고, 원클릭으로 카드뉴스까지 생성합니다</p>
</div>

<!-- Search Bar -->
<div class="mb-8">
  <%= form_tag search_path, method: :get, class: "flex gap-2 max-w-2xl" do %>
    <input name="keyword" value="<%= @keyword %>" placeholder="검색할 키워드를 입력하세요 (예: AI, Samsung, startup)"
           autofocus
           class="flex-1 bg-bg border border-border rounded-md px-4 py-3 text-sm text-text placeholder-text-dim outline-none focus:border-accent">
    <button type="submit" class="inline-flex items-center gap-1.5 px-6 py-3 rounded-md text-[13px] font-semibold bg-accent text-bg hover:bg-accent-hover transition-colors whitespace-nowrap">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      검색
    </button>
  <% end %>
</div>

<% if @keyword.present? %>
  <!-- Pipeline Info -->
  <div class="mb-6 bg-surface border border-border rounded-lg p-4">
    <div class="flex items-center gap-6 text-xs text-text-dim">
      <span class="flex items-center gap-2">
        <span class="w-5 h-5 rounded-full bg-accent text-bg flex items-center justify-center text-[10px] font-bold">1</span>
        검색
      </span>
      <span class="text-border">→</span>
      <span class="flex items-center gap-2">
        <span class="w-5 h-5 rounded-full bg-accent text-bg flex items-center justify-center text-[10px] font-bold">2</span>
        본문 수집
      </span>
      <span class="text-border">→</span>
      <span class="flex items-center gap-2">
        <span class="w-5 h-5 rounded-full bg-accent text-bg flex items-center justify-center text-[10px] font-bold">3</span>
        한국어 번역
      </span>
      <span class="text-border">→</span>
      <span class="flex items-center gap-2">
        <span class="w-5 h-5 rounded-full bg-accent text-bg flex items-center justify-center text-[10px] font-bold">4</span>
        카드뉴스 생성
      </span>
    </div>
  </div>

  <div class="mb-4 text-sm text-text-muted">
    "<span class="text-accent font-semibold"><%= @keyword %></span>" 검색 결과 <span class="font-semibold"><%= @results.size %></span>건
  </div>

  <% if @results.any? %>
    <div class="flex flex-col gap-3">
      <% @results.each do |result| %>
        <div class="bg-surface border border-border rounded-lg p-5 hover:border-accent/30 transition-colors">
          <div class="flex justify-between items-start gap-4">
            <div class="flex-1 min-w-0">
              <a href="<%= result[:url] %>" target="_blank" rel="noopener noreferrer"
                 class="font-semibold text-text hover:text-accent transition-colors block mb-1.5">
                <%= result[:title] %>
              </a>
              <% if result[:description].present? %>
                <p class="text-sm text-text-muted leading-relaxed mb-2"><%= result[:description].truncate(200) %></p>
              <% end %>
              <div class="flex items-center gap-3 text-xs text-text-dim">
                <% if result[:source].present? %>
                  <span class="font-semibold"><%= result[:source] %></span>
                <% end %>
                <% if result[:published_at].present? %>
                  <span class="font-mono tabular-nums"><%= Time.parse(result[:published_at]).strftime("%Y-%m-%d %H:%M") rescue result[:published_at] %></span>
                <% end %>
              </div>
            </div>
            <div class="flex gap-2 shrink-0">
              <% existing = Article.find_by(url: result[:url]) %>
              <% if existing&.translated? %>
                <%= link_to new_card_news_path(article_id: existing.id),
                    class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-success-muted text-success whitespace-nowrap" do %>
                  카드뉴스 편집
                <% end %>
              <% elsif existing %>
                <%= form_tag pipeline_search_path, method: :post do %>
                  <%= hidden_field_tag :url, result[:url] %>
                  <%= hidden_field_tag :title, result[:title] %>
                  <%= hidden_field_tag :keyword, @keyword %>
                  <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-warning-muted text-warning whitespace-nowrap">
                    번역 + 카드뉴스
                  </button>
                <% end %>
              <% else %>
                <%= form_tag pipeline_search_path, method: :post do %>
                  <%= hidden_field_tag :url, result[:url] %>
                  <%= hidden_field_tag :title, result[:title] %>
                  <%= hidden_field_tag :keyword, @keyword %>
                  <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-accent text-bg hover:bg-accent-hover transition-colors whitespace-nowrap">
                    카드뉴스 만들기
                  </button>
                <% end %>
                <%= form_tag import_search_path, method: :post do %>
                  <%= hidden_field_tag :url, result[:url] %>
                  <%= hidden_field_tag :title, result[:title] %>
                  <%= hidden_field_tag :keyword, @keyword %>
                  <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-surface border border-border text-text-muted hover:bg-surface-hover transition-colors whitespace-nowrap">
                    저장만
                  </button>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-surface border border-border rounded-lg p-12 text-center text-text-dim text-sm">
      검색 결과가 없습니다. 다른 키워드로 시도해보세요.
    </div>
  <% end %>
<% end %>

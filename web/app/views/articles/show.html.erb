<div class="mb-8">
  <div class="flex items-center gap-3 mb-4">
    <%= link_to "← 목록", articles_path, class: "text-sm text-text-muted hover:text-text transition-colors" %>
    <%= status_badge(@article) %>
  </div>
  <h1 class="text-2xl font-bold tracking-tight mb-2"><%= @article.title %></h1>
  <div class="flex items-center gap-4 text-sm text-text-dim">
    <span class="font-mono tabular-nums"><%= @article.created_at&.strftime("%Y-%m-%d %H:%M") %></span>
    <% if @article.url.present? %>
      <%= link_to "원문 보기 →", @article.url, target: "_blank", class: "text-accent hover:text-accent-hover transition-colors" %>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-2 gap-6 mb-8">
  <!-- Original Content -->
  <div class="bg-surface border border-border rounded-lg p-6">
    <h2 class="text-[11px] font-semibold text-text-dim uppercase tracking-wider mb-4">원문</h2>
    <p class="text-sm text-text-muted leading-relaxed"><%= @article.content&.truncate(800) %></p>
  </div>

  <%= render "articles/translation", article: @article %>
</div>

<%= render "articles/platforms", article: @article %>

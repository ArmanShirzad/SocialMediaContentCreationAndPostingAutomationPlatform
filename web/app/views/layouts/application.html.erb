<!DOCTYPE html>
<html lang="ko">
  <head>
    <title><%= content_for(:title) || "ContentFlow" %></title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="ContentFlow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      body { background-color: #0A0A0A; color: #FAFAFA; font-family: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, sans-serif; }
    </style>
  </head>

  <body class="bg-bg text-text font-[Pretendard_Variable,Pretendard,sans-serif] antialiased" style="background-color:#0A0A0A;color:#FAFAFA;">
    <a href="#main-content" class="skip-link">본문으로 건너뛰기</a>
    <div class="grid grid-cols-[240px_1fr] min-h-screen">
      <%= render "shared/sidebar" %>
      <main id="main-content" class="p-8 overflow-y-auto">
        <% if flash[:notice] %>
          <div class="mb-4 px-4 py-3 rounded-md bg-success-muted text-success text-sm"><%= flash[:notice] %></div>
        <% end %>
        <% if flash[:alert] %>
          <div class="mb-4 px-4 py-3 rounded-md bg-error-muted text-error text-sm"><%= flash[:alert] %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>

<div class="mb-8">
  <h1 class="text-2xl font-bold tracking-tight mb-1">설정</h1>
  <p class="text-sm text-text-muted">API 키 및 자동화 설정</p>
</div>

<%= form_tag settings_path, method: :patch do %>
  <div class="space-y-6 max-w-2xl">

    <!-- Groq API -->
    <fieldset class="bg-surface border border-border rounded-lg p-6">
      <legend class="text-sm font-semibold mb-1">Groq API</legend>
      <p class="text-[12px] text-text-dim mb-4">번역 및 요약용 LLM 서비스</p>
      <div class="flex flex-col gap-1.5">
        <label for="setting-groq" class="text-[13px] font-semibold text-text-muted">GROQ_API_KEY</label>
        <input id="setting-groq" name="settings[GROQ_API_KEY]"
               type="password" autocomplete="off"
               class="bg-bg border border-border rounded-md px-3 py-2 text-[13px] text-text outline-none focus:border-accent font-mono"
               placeholder="<%= @settings.dig('GROQ_API_KEY', :masked).present? ? @settings.dig('GROQ_API_KEY', :masked) : '키를 입력하세요' %>">
      </div>
    </fieldset>

    <!-- Pexels API -->
    <fieldset class="bg-surface border border-border rounded-lg p-6">
      <legend class="text-sm font-semibold mb-1">Pexels API</legend>
      <p class="text-[12px] text-text-dim mb-4">스톡 이미지 및 비디오</p>
      <div class="flex flex-col gap-1.5">
        <label for="setting-pexels" class="text-[13px] font-semibold text-text-muted">PEXELS_API_KEY</label>
        <input id="setting-pexels" name="settings[PEXELS_API_KEY]"
               type="password" autocomplete="off"
               class="bg-bg border border-border rounded-md px-3 py-2 text-[13px] text-text outline-none focus:border-accent font-mono"
               placeholder="<%= @settings.dig('PEXELS_API_KEY', :masked).present? ? @settings.dig('PEXELS_API_KEY', :masked) : '키를 입력하세요' %>">
      </div>
    </fieldset>

    <!-- Instagram -->
    <fieldset class="bg-surface border border-border rounded-lg p-6">
      <legend class="text-sm font-semibold mb-1">Instagram</legend>
      <p class="text-[12px] text-text-dim mb-4">인스타그램 포스팅 계정</p>
      <div class="grid grid-cols-2 gap-4">
        <div class="flex flex-col gap-1.5">
          <label for="setting-ig-user" class="text-[13px] font-semibold text-text-muted">INSTAGRAM_USERNAME</label>
          <input id="setting-ig-user" name="settings[INSTAGRAM_USERNAME]" value="<%= @settings.dig('INSTAGRAM_USERNAME', :value) %>"
                 class="bg-bg border border-border rounded-md px-3 py-2 text-[13px] text-text outline-none focus:border-accent">
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="setting-ig-pass" class="text-[13px] font-semibold text-text-muted">INSTAGRAM_PASSWORD</label>
          <input id="setting-ig-pass" name="settings[INSTAGRAM_PASSWORD]"
                 type="password"
                 class="bg-bg border border-border rounded-md px-3 py-2 text-[13px] text-text outline-none focus:border-accent"
                 placeholder="<%= @settings.dig('INSTAGRAM_PASSWORD', :masked).present? ? @settings.dig('INSTAGRAM_PASSWORD', :masked) : '비밀번호 입력' %>">
        </div>
      </div>
    </fieldset>

    <!-- Telegram -->
    <fieldset class="bg-surface border border-border rounded-lg p-6">
      <legend class="text-sm font-semibold mb-1">Telegram</legend>
      <p class="text-[12px] text-text-dim mb-4">텔레그램 봇 설정</p>
      <div class="grid grid-cols-2 gap-4">
        <div class="flex flex-col gap-1.5">
          <label for="setting-tg-token" class="text-[13px] font-semibold text-text-muted">TELEGRAM_BOT_TOKEN</label>
          <input id="setting-tg-token" name="settings[TELEGRAM_BOT_TOKEN]"
                 type="password"
                 class="bg-bg border border-border rounded-md px-3 py-2 text-[13px] text-text outline-none focus:border-accent font-mono"
                 placeholder="<%= @settings.dig('TELEGRAM_BOT_TOKEN', :masked).present? ? @settings.dig('TELEGRAM_BOT_TOKEN', :masked) : '토큰 입력' %>">
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="setting-tg-chat" class="text-[13px] font-semibold text-text-muted">TELEGRAM_CHAT_ID</label>
          <input id="setting-tg-chat" name="settings[TELEGRAM_CHAT_ID]" value="<%= @settings.dig('TELEGRAM_CHAT_ID', :value) %>"
                 class="bg-bg border border-border rounded-md px-3 py-2 text-[13px] text-text outline-none focus:border-accent font-mono">
        </div>
      </div>
    </fieldset>

    <!-- X (Twitter) -->
    <fieldset class="bg-surface border border-border rounded-lg p-6">
      <legend class="text-sm font-semibold mb-1">X (Twitter)</legend>
      <p class="text-[12px] text-text-dim mb-4">X API 인증 정보</p>
      <div class="grid grid-cols-2 gap-4">
        <% %w[X_BEARER_TOKEN X_API_KEY X_API_KEY_SECRET X_ACCESS_TOKEN X_ACCESS_TOKEN_SECRET].each_with_index do |key, i| %>
          <div class="flex flex-col gap-1.5">
            <label for="setting-x-<%= i %>" class="text-[13px] font-semibold text-text-muted"><%= key %></label>
            <input id="setting-x-<%= i %>" name="settings[<%= key %>]"
                   type="password"
                   class="bg-bg border border-border rounded-md px-3 py-2 text-[13px] text-text outline-none focus:border-accent font-mono"
                   placeholder="<%= @settings.dig(key, :masked).present? ? @settings.dig(key, :masked) : '키 입력' %>">
          </div>
        <% end %>
      </div>
    </fieldset>

    <button type="submit" class="inline-flex items-center gap-1.5 px-6 py-2.5 rounded-md text-[13px] font-semibold bg-accent text-bg hover:bg-accent-hover transition-colors">
      설정 저장
    </button>
  </div>
<% end %>

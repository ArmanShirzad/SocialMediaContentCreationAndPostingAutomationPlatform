# ===========================================
# Groq API (번역 및 요약용 LLM)
# https://console.groq.com/keys 에서 발급
# ===========================================
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ===========================================
# Pexels API (스톡 이미지/비디오)
# https://www.pexels.com/api/new/ 에서 발급
# ===========================================
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# Telegram Bot
# @BotFather 에서 봇 생성 후 토큰 발급
# CHAT_ID: 채널이면 @channel_name 또는 -100xxxxxxxxxx
# ===========================================
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=@your_channel_name

# ===========================================
# X (Twitter) API
# https://developer.x.com/en/portal/dashboard 에서 발급
# App 권한: Read and Write 필요
# ===========================================
X_BEARER_TOKEN=AAAAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxx
X_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
X_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
X_ACCESS_TOKEN=1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
X_ACCESS_TOKEN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# Instagram
# 게시에 사용할 Instagram 계정 정보
# ===========================================
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# ===========================================
# YouTube (선택)
# Google Cloud Console에서 OAuth 2.0 Client ID 생성 후
# client_secret_xxxxx.json 파일을 프로젝트 루트에 배치
# 환경변수로 파일명을 지정하거나 기본값 사용
# ===========================================
# YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
